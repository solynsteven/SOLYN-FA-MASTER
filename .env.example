# Neon 连接串（Neon 控制台 → Connection Details，选 Pooled connection）
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# 会话签名密钥：至少 32 位随机字符串（可用 `openssl rand -base64 48` 生成）
AUTH_SECRET="change-me-to-a-long-random-string"

# API Key 加密密钥：32 字节 base64（`openssl rand -base64 32`）。一旦设置不要更改，否则已保存的 Key 无法解密
ENCRYPTION_KEY="change-me-base64-32-bytes"

# VDR 文件存储：在 Vercel Storage 创建 Private Blob 并连接到项目后自动注入；本地留空则存到 .data/vdr
BLOB_READ_WRITE_TOKEN=
# 可选：Blob store 为 Public 时设为 public（默认 private）
# VDR_BLOB_ACCESS=public

# 邮件服务（Resend）：邀请邮件、登录邮箱验证码、陌生设备告警。未配置时邀请链接需手动复制发送
RESEND_API_KEY=
MAIL_FROM="SOLYN FA MASTER <noreply@solynadvisory.com>"
# 可选：邀请链接使用的站点地址（默认取请求域名）
# SITE_URL=https://fa.solynadvisory.com
